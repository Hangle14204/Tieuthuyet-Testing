              "code": "cy.get('img').each(($img, index) => {\n  const alt = $img.attr('alt');\n  const src = $img.attr('src');\n  if (!alt) {\n    cy.log(`Failed, <img> #${index + 1} missing alt. Src: ${src}`);\n    Cypress._.defer(() => {\n      throw new Error(`<img> #${index + 1} missing alt attribute`);\n    });\n  } else if (alt.trim() === \"\") {\n    cy.log(`Failed:, <img> #${index + 1} empty alt. Src: ${src}`);\n    Cypress._.defer(() => {\n      throw new Error(`<img> #${index + 1} has empty alt attribute`);\n    });\n  } else {\n    cy.log(`Passed, <img> #${index + 1} alt: \"${alt}\"`);\n  }\n});",
